# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Database (Postgres) ---
# Neon / Vercel Postgres / Prisma Postgres. Untuk Neon, pakai connection string
# yang "pooled" saat runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Sesi peserta (FR-002) ---
# Kunci untuk menandatangani cookie sesi peserta.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Aplikasi ---
APP_BASE_URL="http://localhost:3000"

# --- Sertifikat (Fase 2) ---
CERTIFICATE_PREFIX="TOEFLP"
# Sampai dashboard admin (Fase 3) ada, tiga nilai ini diatur lewat env var.
CERTIFICATE_INSTITUTION_NAME="Thunder Test Center"
CERTIFICATE_SIGNATORY_NAME=""
CERTIFICATE_SIGNATORY_POSITION=""

# --- Audio Listening (FR-023, Fase 4) ---
# Supabase Storage. Bucket harus PRIVATE; aplikasi membuat signed URL
# berumur pendek untuk setiap sesi Listening.
#
# Kosongkan KEDUANYA untuk mode pengembangan lokal: audio otomatis dibaca
# dari file di content/<slug-kode-paket>/<audioFile>, mis.
# content/test-01/listening.mp3 (lihat src/lib/audioStorage.ts). Begitu
# SUPABASE_URL & SUPABASE_SECRET_KEY diisi, aplikasi otomatis beralih ke
# signed URL — tidak ada saklar terpisah untuk ini.
#
# WAJIB diisi di produksi (Vercel): disk-nya tidak permanen, jadi audio
# tidak bisa diandalkan sebagai file lokal begitu di-deploy.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_AUDIO_BUCKET="toefl-audio"

# --- Admin (Fase 3) ---
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_AUTH_SECRET=""

# Hanya dipakai oleh `npm run db:seed-admin` untuk membuat/reset akun admin
# pertama. Ganti nilainya lalu jalankan ulang skrip kapan pun ingin
# mengubah password admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
